<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targets net8.0;net9.0;net10.0 like every other test project (inherited from
         Directory.Build.props). The host TFM is irrelevant to what is asserted - the code under test is
         always compiled against ReferenceAssemblies.Net.Net80 (Verifiers.cs) - but a single-target test
         project breaks any framework-scoped solution run: `dotnet test EverTask.slnx -f net10.0` passes
         TargetFramework as a GLOBAL property, which a project-level assignment cannot override, and the
         restore has no net10.0 target -> NETSDK1005. The analyzer libraries themselves stay netstandard2.0
         (they must) and are unaffected: they are reached only through ProjectReference, which undefines
         TargetFramework. -->
    <IsPackable>false</IsPackable>
    <!-- Analyzer-test sources are string literals; relax nullable/CS warnings-as-errors noise. -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
    <!-- Pin CodeAnalysis: the *.Testing packages float their dependency to an ancient .NETFramework floor
         (1.0.1 -> NU1701). Direct references unify everything on the modern build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced as libraries (NOT as analyzers) so tests can instantiate the analyzer / code-fix types. -->
    <ProjectReference Include="..\..\analyzers\EverTask.Analyzers\EverTask.Analyzers.csproj" />
    <ProjectReference Include="..\..\analyzers\EverTask.Analyzers.CodeFixes\EverTask.Analyzers.CodeFixes.csproj" />
  </ItemGroup>

</Project>
