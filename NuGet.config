<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      The consumer-compatibility fixture (test/EverTask.ConsumerCompatibility.Baseline) is compiled against
      the two EverTask packages master shipped before durable occurrences, kept in this folder. Only the
      source is added: no <clear /> and no packageSourceMapping, so whatever feeds a machine already has keep
      working. Version 3.11.0-issue23baseline does not exist upstream, so nothing else can resolve to it.

      If your own NuGet configuration DOES use package source mapping, map EverTask* to this source too, or
      restore of that one project will not find the baseline packages.
    -->
    <add key="issue23-baseline" value="nupkg/issue23-baseline" />
  </packageSources>
</configuration>
