<!-- For more info on central package management go to https://devblogs.microsoft.com/nuget/introducing-central-package-management/ -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <!-- Pinned: transitive/older versions have known high-severity vulnerabilities (GHSA-37gx-xxp4-5rgx,
         GHSA-w3x6-4m5h-cxqf, plus the 2026-08 batch GHSA-cvvh-rhrc-wg4q/GHSA-g8r8-53c2-pm3f/GHSA-mmjf-rqrv-855v/
         GHSA-8q5v-6pqq-x66h/GHSA-23rf-6693-g89p patched in 10.0.10) -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <!-- Built-in OpenAPI document generation for Monitor.Api (issue #20: replaces Swashbuckle, follows the
         runtime's Microsoft.OpenApi generation so it can never conflict with the host's OpenAPI stack) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Pinned: the Microsoft.OpenApi 2.0.0 transitive of Microsoft.AspNetCore.OpenApi is flagged by
         GHSA-v5pm-xwqc-g5wc (patched in 2.7.5). Direct reference in Monitor.Api overrides the transitive. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.19" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.19" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.19" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.19" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.19" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="9.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.19">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.19" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.19" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="9.0.19" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.19" />
    <!-- Pinned: transitive/older versions have known high-severity vulnerabilities (GHSA-37gx-xxp4-5rgx,
         GHSA-w3x6-4m5h-cxqf, plus the 2026-08 batch patched in 9.0.18) -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="9.0.19" />
    <!-- Built-in OpenAPI document generation for Monitor.Api (issue #20) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.19" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.30" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.30" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.30">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.30" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.30" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.30" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.30" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- Pinned: transitive/older versions have known high-severity vulnerabilities (GHSA-37gx-xxp4-5rgx,
         GHSA-w3x6-4m5h-cxqf, plus the 2026-08 batch patched in 8.0.4) -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roslyn analyzer (analyzers/EverTask.Analyzers[.CodeFixes]). Pinned to 4.8.0: an analyzer compiled
         against an older Roslyn API loads on every newer compiler/IDE host, maximizing VS/SDK reach for
         consumers. PrivateAssets="all" on the references keeps CodeAnalysis out of the shipped nupkg deps. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <!-- Analyzer/code-fix unit testing (test/EverTask.Analyzers.Tests). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageVersion>
  </ItemGroup>

  <ItemGroup>
    <!-- Benchmarks only (benchmarks/EverTask.Benchmarks) — not referenced by any shipped/test project -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <!-- Load harness only (benchmarks/EverTask.LoadHarness) — fixed-memory concurrent latency percentiles -->
    <PackageVersion Include="HdrHistogram" Version="2.5.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- Option 2 (feasibility §4): pin System.Text.Json across all TFMs so the core uses a single, known STJ
         version instead of each runtime's in-box build. 10.0.x is the highest, so no NU1605 downgrade. -->
    <PackageVersion Include="System.Text.Json" Version="10.0.11" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <!-- Scalar API reference UI for EverTask.Monitor.Api.Scalar (net8/9/10, zero dependencies) -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageVersion Include="UUIDNext" Version="4.2.4" />
    <!-- Pinned: the SQLitePCLRaw.lib.e_sqlite3 bundled by EF Core Sqlite's transitive 2.1.x is flagged by
         GHSA-2m69-gcr7-jv3q (bundles SQLite < 3.50.2). 3.0.x bundles a patched SQLite and falls outside the
         advisory's affected range (<= 2.1.11). Direct reference in EverTask.Storage.Sqlite overrides the
         transitive (NU1903 under TreatWarningsAsErrors). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pinned: Testcontainers' transitive SSH.NET <= 2025.1.0 is flagged by GHSA-q939-rpr3-3284 (high).
         Direct reference in the Testcontainers consumers (Tests.Storage, LoadHarness) overrides the transitive. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.MariaDb" Version="4.14.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>
